# Udev rules for Royal Kludge RK855 (RK68) Mechanical Keyboard
# Copy this file to /etc/udev/rules.d/99-rk855.rules and reload:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Normal Keyboard HID Configuration Interface (VID: 0x0c45, PID: 0x8018)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8018", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8018", MODE="0666", TAG+="uaccess"

# Sonix ISP Bootloader Interface (VID: 0x0c45, PID: 0x82aa)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="82aa", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="82aa", MODE="0666", TAG+="uaccess"
